generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model accommodation_amenities {
  accommodation_id Int
  amenity_id       Int
  note             String?
  amenities        amenities      @relation(fields: [amenity_id], references: [id])
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@id([accommodation_id, amenity_id])
}

model accommodation_edit_history {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  changed_by       Int
  field_name       String?
  old_value        String?
  new_value        String?
  created_at       DateTime       @default(now())
  users            users          @relation(fields: [changed_by], references: [id])
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])
}

model accommodation_photos {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  url              String
  thumbnail_url    String?
  caption          String?
  sort_order       Int            @default(0)
  is_primary       Boolean        @default(false)
  created_at       DateTime       @default(now())
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@index([accommodation_id])
}

model accommodation_tags {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  tag_name         String
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])
}

model accommodation_translations {
  id                 Int            @id @default(autoincrement())
  accommodation_id   Int
  language           String
  name               String?
  description        String?
  house_rules        String?
  checkin_guide      String?
  is_auto_translated Boolean        @default(false)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  accommodations     accommodations @relation(fields: [accommodation_id], references: [id])

  @@unique([accommodation_id, language])
}

model accommodation_view_stats {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  date             DateTime
  view_count       Int            @default(0)
  unique_count     Int            @default(0)
  created_at       DateTime       @default(now())
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@unique([accommodation_id, date])
  @@index([accommodation_id, date])
}

model accommodation_views {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  user_id          Int?
  view_date        DateTime
  ip_address       String?
  created_at       DateTime       @default(now())
  users            users?         @relation(fields: [user_id], references: [id])
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@index([accommodation_id, view_date])
}

model accommodations {
  id                                   Int                          @id @default(autoincrement())
  host_id                              Int
  name                                 String
  description                          String?
  accommodation_type                   String
  space_type                           String
  address                              String
  address_detail                       String?
  city                                 String?
  province                             String?
  country                              String                       @default("KR")
  postal_code                          String?
  latitude                             Float?
  longitude                            Float?
  bedrooms                             Int                          @default(1)
  bathrooms                            Int                          @default(1)
  bathrooms_shared                     Int                          @default(0)
  max_guests                           Int
  base_guests                          Int
  area_sqm                             Float?
  base_price                           Float
  weekend_price                        Float?
  extra_guest_fee                      Float                        @default(0)
  cleaning_fee                         Float                        @default(0)
  min_nights                           Int                          @default(1)
  max_nights                           Int                          @default(365)
  checkin_time                         String                       @default("15:00")
  checkout_time                        String                       @default("11:00")
  checkin_method                       String?
  checkin_guide                        String?
  preparation_days                     Int                          @default(0)
  cancellation_policy                  String                       @default("moderate")
  house_rules                          String?
  instant_booking                      Boolean                      @default(false)
  pet_allowed                          Boolean                      @default(false)
  parking_type                         String                       @default("none")
  parking_spaces                       Int                          @default(0)
  status                               String                       @default("draft")
  admin_approved_at                    DateTime?
  admin_id                             Int?
  rejection_reason                     String?
  avg_rating                           Float                        @default(0)
  review_count                         Int                          @default(0)
  booking_count                        Int                          @default(0)
  created_at                           DateTime                     @default(now())
  updated_at                           DateTime                     @updatedAt
  accommodation_amenities              accommodation_amenities[]
  accommodation_edit_history           accommodation_edit_history[]
  accommodation_photos                 accommodation_photos[]
  accommodation_tags                   accommodation_tags[]
  accommodation_translations           accommodation_translations[]
  accommodation_view_stats             accommodation_view_stats[]
  accommodation_views                  accommodation_views[]
  users_accommodations_admin_idTousers users?                       @relation("accommodations_admin_idTousers", fields: [admin_id], references: [id])
  users_accommodations_host_idTousers  users                        @relation("accommodations_host_idTousers", fields: [host_id], references: [id])
  availability_calendar                availability_calendar[]
  conversation_rooms                   conversation_rooms[]
  custom_date_pricing                  custom_date_pricing[]
  featured_accommodations              featured_accommodations[]
  long_stay_discounts                  long_stay_discounts[]
  reservations                         reservations[]
  reviews                              reviews[]
  rooms                                rooms[]
  seasonal_pricing                     seasonal_pricing[]
  wishlist_items                       wishlist_items[]

  @@index([avg_rating])
  @@index([base_price])
  @@index([city, province])
  @@index([accommodation_type])
  @@index([status])
  @@index([host_id])
}

model admin_activity_logs {
  id          Int      @id @default(autoincrement())
  admin_id    Int
  action      String
  target_type String?
  target_id   Int?
  details     String?
  ip_address  String?
  created_at  DateTime @default(now())
  users       users    @relation(fields: [admin_id], references: [id])

  @@index([created_at])
  @@index([admin_id])
}

model amenities {
  id                      Int                       @id @default(autoincrement())
  category_id             Int
  name                    String
  display_name_ko         String
  display_name_en         String?
  display_name_ja         String?
  display_name_zh         String?
  icon                    String?
  sort_order              Int                       @default(0)
  is_active               Boolean                   @default(true)
  accommodation_amenities accommodation_amenities[]
  amenity_categories      amenity_categories        @relation(fields: [category_id], references: [id])
}

model amenity_categories {
  id              Int         @id @default(autoincrement())
  name            String
  display_name_ko String?
  display_name_en String?
  sort_order      Int         @default(0)
  amenities       amenities[]
}

model auto_message_settings {
  id                   Int      @id @default(autoincrement())
  host_id              Int
  trigger_type         String
  message_content      String
  trigger_hours_before Int      @default(0)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  users                users    @relation(fields: [host_id], references: [id])
}

model availability_calendar {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  date             DateTime
  is_available     Boolean        @default(true)
  blocked_reason   String?
  reservation_id   Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@unique([accommodation_id, date])
  @@index([accommodation_id, date])
}

model banned_words {
  id         Int      @id @default(autoincrement())
  word       String   @unique
  created_at DateTime @default(now())
}

model banners {
  id         Int       @id @default(autoincrement())
  title      String
  image_url  String
  link_url   String?
  position   String    @default("main_top")
  start_date DateTime?
  end_date   DateTime?
  is_active  Boolean   @default(true)
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime @updatedAt
}

model beds {
  id       Int    @id @default(autoincrement())
  room_id  Int
  bed_type String
  quantity Int    @default(1)
  rooms    rooms  @relation(fields: [room_id], references: [id])
}

model commission_settings {
  id             Int       @id @default(autoincrement())
  type           String
  rate           Float
  effective_from DateTime
  effective_to   DateTime?
  created_by     Int?
  created_at     DateTime  @default(now())
  users          users?    @relation(fields: [created_by], references: [id])
}

model conversation_rooms {
  id                                       Int             @id @default(autoincrement())
  guest_id                                 Int
  host_id                                  Int
  accommodation_id                         Int?
  reservation_id                           Int?
  last_message_at                          DateTime?
  last_message_preview                     String?
  is_archived_by_guest                     Boolean         @default(false)
  is_archived_by_host                      Boolean         @default(false)
  created_at                               DateTime        @default(now())
  updated_at                               DateTime        @updatedAt
  reservations                             reservations?   @relation(fields: [reservation_id], references: [id])
  accommodations                           accommodations? @relation(fields: [accommodation_id], references: [id])
  users_conversation_rooms_host_idTousers  users           @relation("conversation_rooms_host_idTousers", fields: [host_id], references: [id])
  users_conversation_rooms_guest_idTousers users           @relation("conversation_rooms_guest_idTousers", fields: [guest_id], references: [id])
  messages                                 messages[]

  @@index([host_id])
  @@index([guest_id])
}

model coupon_usages {
  id              Int          @id @default(autoincrement())
  coupon_id       Int
  user_id         Int
  reservation_id  Int
  discount_amount Float
  used_at         DateTime     @default(now())
  reservations    reservations @relation(fields: [reservation_id], references: [id])
  users           users        @relation(fields: [user_id], references: [id])
  coupons         coupons      @relation(fields: [coupon_id], references: [id])

  @@index([user_id])
  @@index([coupon_id])
}

model coupons {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  discount_type    String
  discount_value   Float
  min_order_amount Float           @default(0)
  max_discount     Float?
  valid_from       DateTime
  valid_to         DateTime
  total_quantity   Int?
  used_count       Int             @default(0)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  coupon_usages    coupon_usages[]
  reservations     reservations[]
}

model custom_date_pricing {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  date             DateTime
  price            Float
  created_at       DateTime       @default(now())
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@unique([accommodation_id, date])
}

model email_templates {
  id           Int      @id @default(autoincrement())
  template_key String
  language     String   @default("ko")
  subject      String
  body         String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([template_key, language])
}

model exchange_rates {
  id              Int      @id @default(autoincrement())
  base_currency   String   @default("KRW")
  target_currency String
  rate            Float
  fetched_at      DateTime
  created_at      DateTime @default(now())
}

model faq_categories {
  id         Int     @id @default(autoincrement())
  name_ko    String
  name_en    String?
  sort_order Int     @default(0)
  faqs       faqs[]
}

model faq_translations {
  id       Int     @id @default(autoincrement())
  faq_id   Int
  language String
  question String?
  answer   String?
  faqs     faqs    @relation(fields: [faq_id], references: [id])

  @@unique([faq_id, language])
}

model faqs {
  id               Int                @id @default(autoincrement())
  category_id      Int
  question         String
  answer           String
  sort_order       Int                @default(0)
  is_published     Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  faq_translations faq_translations[]
  faq_categories   faq_categories     @relation(fields: [category_id], references: [id])
}

model featured_accommodations {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  sort_order       Int            @default(0)
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now())
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])
}

model featured_regions {
  id             Int      @id @default(autoincrement())
  region_name_ko String
  region_name_en String?
  image_url      String?
  search_keyword String?
  sort_order     Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
}

model host_penalties {
  id                                   Int           @id @default(autoincrement())
  host_id                              Int
  reservation_id                       Int?
  type                                 String
  description                          String?
  penalty_action                       String
  admin_id                             Int?
  created_at                           DateTime      @default(now())
  users_host_penalties_admin_idTousers users?        @relation("host_penalties_admin_idTousers", fields: [admin_id], references: [id])
  reservations                         reservations? @relation(fields: [reservation_id], references: [id])
  users_host_penalties_host_idTousers  users         @relation("host_penalties_host_idTousers", fields: [host_id], references: [id])

  @@index([host_id])
}

model host_profiles {
  id                        Int      @id @default(autoincrement())
  user_id                   Int      @unique
  bank_name                 String
  account_number            String
  account_holder            String
  address                   String?
  response_rate             Float    @default(0)
  avg_response_time_minutes Int      @default(0)
  total_reservations        Int      @default(0)
  total_reviews             Int      @default(0)
  avg_rating                Float    @default(0)
  cancellation_count        Int      @default(0)
  host_since                DateTime @default(now())
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  users                     users    @relation(fields: [user_id], references: [id])
}

model login_history {
  id              Int      @id @default(autoincrement())
  user_id         Int
  login_type      String
  social_provider String?
  ip_address      String?
  device_info     String?
  status          String
  created_at      DateTime @default(now())
  users           users    @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
}

model long_stay_discounts {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  min_nights       Int
  discount_rate    Float
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])

  @@unique([accommodation_id, min_nights])
}

model message_images {
  id         Int      @id @default(autoincrement())
  message_id Int
  url        String
  created_at DateTime @default(now())
  messages   messages @relation(fields: [message_id], references: [id])
}

model messages {
  id                  Int                @id @default(autoincrement())
  room_id             Int
  sender_id           Int?
  content             String
  message_type        String             @default("text")
  translated_content  String?
  translated_language String?
  is_read             Boolean            @default(false)
  read_at             DateTime?
  created_at          DateTime           @default(now())
  message_images      message_images[]
  users               users?             @relation(fields: [sender_id], references: [id])
  conversation_rooms  conversation_rooms @relation(fields: [room_id], references: [id])

  @@index([room_id, created_at])
}

model notice_translations {
  id        Int     @id @default(autoincrement())
  notice_id Int
  language  String
  title     String?
  content   String?
  notices   notices @relation(fields: [notice_id], references: [id])

  @@unique([notice_id, language])
}

model notices {
  id                  Int                   @id @default(autoincrement())
  author_id           Int
  title               String
  content             String
  is_published        Boolean               @default(false)
  is_pinned           Boolean               @default(false)
  view_count          Int                   @default(0)
  published_at        DateTime?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  notice_translations notice_translations[]
  users               users                 @relation(fields: [author_id], references: [id])
}

model notifications {
  id             Int       @id @default(autoincrement())
  user_id        Int
  type           String
  title          String
  content        String?
  reference_type String?
  reference_id   Int?
  channel        String
  is_read        Boolean   @default(false)
  read_at        DateTime?
  sent_at        DateTime?
  created_at     DateTime  @default(now())
  users          users     @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read, created_at])
}

model payments {
  id                Int          @id @default(autoincrement())
  reservation_id    Int
  user_id           Int
  payment_method    String
  pg_provider       String?
  pg_transaction_id String?
  pg_receipt_url    String?
  amount            Float
  currency          String       @default("KRW")
  display_amount    Float?
  display_currency  String?
  exchange_rate     Float?
  status            String       @default("pending")
  paid_at           DateTime?
  failed_reason     String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  users             users        @relation(fields: [user_id], references: [id])
  reservations      reservations @relation(fields: [reservation_id], references: [id])
  refunds           refunds[]

  @@index([reservation_id])
}

model popular_searches {
  id           Int      @id @default(autoincrement())
  keyword      String
  search_count Int      @default(0)
  period_start DateTime
  period_end   DateTime
  created_at   DateTime @default(now())
}

model refresh_tokens {
  id          Int      @id @default(autoincrement())
  user_id     Int
  token       String   @unique
  device_info String?
  expires_at  DateTime
  created_at  DateTime @default(now())
  users       users    @relation(fields: [user_id], references: [id])
}

model refunds {
  id             Int          @id @default(autoincrement())
  payment_id     Int
  reservation_id Int
  amount         Float
  reason         String?
  refund_policy  String?
  status         String       @default("requested")
  pg_refund_id   String?
  requested_at   DateTime     @default(now())
  processed_at   DateTime?
  completed_at   DateTime?
  created_at     DateTime     @default(now())
  reservations   reservations @relation(fields: [reservation_id], references: [id])
  payments       payments     @relation(fields: [payment_id], references: [id])
}

model report_actions {
  id         Int      @id @default(autoincrement())
  report_id  Int
  admin_id   Int
  action     String
  note       String?
  created_at DateTime @default(now())
  users      users    @relation(fields: [admin_id], references: [id])
  reports    reports  @relation(fields: [report_id], references: [id])
}

model reports {
  id             Int              @id @default(autoincrement())
  reporter_id    Int
  target_type    String
  target_id      Int
  reason         String
  description    String?
  status         String           @default("pending")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  report_actions report_actions[]
  users          users            @relation(fields: [reporter_id], references: [id])

  @@index([status])
}

model reservation_admin_memos {
  id             Int          @id @default(autoincrement())
  reservation_id Int
  admin_id       Int
  content        String
  created_at     DateTime     @default(now())
  users          users        @relation(fields: [admin_id], references: [id])
  reservations   reservations @relation(fields: [reservation_id], references: [id])

  @@index([reservation_id])
}

model reservation_changes {
  id                Int          @id @default(autoincrement())
  reservation_id    Int
  requested_by      Int
  original_checkin  DateTime?
  original_checkout DateTime?
  original_adults   Int?
  original_children Int?
  new_checkin       DateTime?
  new_checkout      DateTime?
  new_adults        Int?
  new_children      Int?
  price_difference  Float        @default(0)
  status            String       @default("requested")
  host_response_at  DateTime?
  created_at        DateTime     @default(now())
  users             users        @relation(fields: [requested_by], references: [id])
  reservations      reservations @relation(fields: [reservation_id], references: [id])
}

model reservation_nightly_details {
  id             Int          @id @default(autoincrement())
  reservation_id Int
  date           DateTime
  base_price     Float
  applied_price  Float
  price_type     String
  created_at     DateTime     @default(now())
  reservations   reservations @relation(fields: [reservation_id], references: [id])

  @@unique([reservation_id, date])
  @@index([reservation_id])
}

model reservation_status_history {
  id             Int          @id @default(autoincrement())
  reservation_id Int
  from_status    String?
  to_status      String
  changed_by     Int?
  note           String?
  created_at     DateTime     @default(now())
  users          users?       @relation(fields: [changed_by], references: [id])
  reservations   reservations @relation(fields: [reservation_id], references: [id])
}

model reservations {
  id                                 Int                           @id @default(autoincrement())
  reservation_number                 String                        @unique
  guest_id                           Int
  accommodation_id                   Int
  host_id                            Int
  checkin_date                       DateTime
  checkout_date                      DateTime
  nights                             Int
  adults                             Int                           @default(1)
  children                           Int                           @default(0)
  infants                            Int                           @default(0)
  nightly_rate                       Float
  accommodation_fee                  Float
  extra_guest_fee                    Float                         @default(0)
  cleaning_fee                       Float                         @default(0)
  long_stay_discount                 Float                         @default(0)
  guest_service_fee                  Float                         @default(0)
  host_service_fee                   Float                         @default(0)
  total_price                        Float
  host_payout                        Float
  coupon_id                          Int?
  coupon_discount                    Float                         @default(0)
  currency                           String                        @default("KRW")
  status                             String                        @default("requested")
  is_instant_booking                 Boolean                       @default(false)
  guest_message                      String?
  cancellation_reason                String?
  cancelled_at                       DateTime?
  cancelled_by                       String?
  host_response_deadline             DateTime?
  host_responded_at                  DateTime?
  checkin_info                       String?
  cancellation_policy                String?
  created_at                         DateTime                      @default(now())
  updated_at                         DateTime                      @updatedAt
  conversation_rooms                 conversation_rooms[]
  coupon_usages                      coupon_usages[]
  host_penalties                     host_penalties[]
  payments                           payments[]
  refunds                            refunds[]
  reservation_admin_memos            reservation_admin_memos[]
  reservation_changes                reservation_changes[]
  reservation_nightly_details        reservation_nightly_details[]
  reservation_status_history         reservation_status_history[]
  coupons                            coupons?                      @relation(fields: [coupon_id], references: [id])
  accommodations                     accommodations                @relation(fields: [accommodation_id], references: [id])
  users_reservations_host_idTousers  users                         @relation("reservations_host_idTousers", fields: [host_id], references: [id])
  users_reservations_guest_idTousers users                         @relation("reservations_guest_idTousers", fields: [guest_id], references: [id])
  reviews                            reviews[]
  settlements                        settlements[]

  @@index([checkin_date, checkout_date])
  @@index([status])
  @@index([accommodation_id])
  @@index([host_id])
  @@index([guest_id])
}

model review_category_ratings {
  id        Int     @id @default(autoincrement())
  review_id Int
  category  String
  rating    Float
  reviews   reviews @relation(fields: [review_id], references: [id])

  @@unique([review_id, category])
}

model review_photos {
  id         Int      @id @default(autoincrement())
  review_id  Int
  url        String
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  reviews    reviews  @relation(fields: [review_id], references: [id])
}

model review_replies {
  id         Int      @id @default(autoincrement())
  review_id  Int      @unique
  user_id    Int
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      users    @relation(fields: [user_id], references: [id])
  reviews    reviews  @relation(fields: [review_id], references: [id])
}

model reviews {
  id                               Int                       @id @default(autoincrement())
  reservation_id                   Int
  reviewer_id                      Int
  reviewee_id                      Int
  accommodation_id                 Int?
  review_type                      String
  overall_rating                   Float
  content                          String
  private_feedback                 String?
  is_published                     Boolean                   @default(false)
  published_at                     DateTime?
  is_edited                        Boolean                   @default(false)
  edit_deadline                    DateTime?
  is_hidden                        Boolean                   @default(false)
  hidden_reason                    String?
  created_at                       DateTime                  @default(now())
  updated_at                       DateTime                  @updatedAt
  review_category_ratings          review_category_ratings[]
  review_photos                    review_photos[]
  review_replies                   review_replies?
  accommodations                   accommodations?           @relation(fields: [accommodation_id], references: [id])
  users_reviews_reviewee_idTousers users                     @relation("reviews_reviewee_idTousers", fields: [reviewee_id], references: [id])
  users_reviews_reviewer_idTousers users                     @relation("reviews_reviewer_idTousers", fields: [reviewer_id], references: [id])
  reservations                     reservations              @relation(fields: [reservation_id], references: [id])

  @@index([reviewer_id])
  @@index([accommodation_id])
}

model rooms {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  room_name        String?
  sort_order       Int            @default(0)
  beds             beds[]
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])
}

model saved_payment_methods {
  id             Int      @id @default(autoincrement())
  user_id        Int
  type           String
  card_last_four String?
  card_brand     String?
  pg_billing_key String?
  nickname       String?
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  users          users    @relation(fields: [user_id], references: [id])
}

model search_history {
  id            Int       @id @default(autoincrement())
  user_id       Int
  keyword       String
  checkin_date  DateTime?
  checkout_date DateTime?
  guests        Int?
  searched_at   DateTime  @default(now())
  users         users     @relation(fields: [user_id], references: [id])

  @@index([user_id, searched_at])
}

model seasonal_pricing {
  id               Int            @id @default(autoincrement())
  accommodation_id Int
  season_name      String?
  start_date       DateTime
  end_date         DateTime
  price            Float
  weekend_price    Float?
  created_at       DateTime       @default(now())
  accommodations   accommodations @relation(fields: [accommodation_id], references: [id])
}

model settlements {
  id                Int          @id @default(autoincrement())
  host_id           Int
  reservation_id    Int
  gross_amount      Float
  commission_rate   Float
  commission_amount Float
  net_amount        Float
  bank_name         String?
  account_number    String?
  account_holder    String?
  status            String       @default("pending")
  scheduled_date    DateTime?
  completed_at      DateTime?
  admin_note        String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  reservations      reservations @relation(fields: [reservation_id], references: [id])
  users             users        @relation(fields: [host_id], references: [id])

  @@index([status])
  @@index([host_id])
}

model superhost_evaluations {
  id                 Int      @id @default(autoincrement())
  host_id            Int
  evaluation_year    Int
  evaluation_quarter Int
  avg_rating         Float?
  total_reservations Int?
  cancellation_rate  Float?
  response_rate      Float?
  is_qualified       Boolean  @default(false)
  evaluated_at       DateTime @default(now())
  users              users    @relation(fields: [host_id], references: [id])

  @@unique([host_id, evaluation_year, evaluation_quarter])
}

model system_settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique
  setting_value String
  description   String?
  updated_by    Int?
  updated_at    DateTime @updatedAt
  users         users?   @relation(fields: [updated_by], references: [id])
}

model terms_versions {
  id              Int               @id @default(autoincrement())
  type            String
  version         String
  content         String
  is_current      Boolean           @default(false)
  effective_date  DateTime
  created_at      DateTime          @default(now())
  user_agreements user_agreements[]

  @@unique([type, version])
}

model user_agreements {
  id               Int            @id @default(autoincrement())
  user_id          Int
  terms_version_id Int
  agreed_at        DateTime       @default(now())
  ip_address       String?
  terms_versions   terms_versions @relation(fields: [terms_version_id], references: [id])
  users            users          @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model user_devices {
  id           Int      @id @default(autoincrement())
  user_id      Int
  device_token String
  device_type  String
  device_name  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  users        users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, device_token])
  @@index([user_id])
}

model user_notification_settings {
  id         Int      @id @default(autoincrement())
  user_id    Int
  channel    String
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, channel])
}

model user_social_accounts {
  id               Int      @id @default(autoincrement())
  user_id          Int
  provider         String
  provider_user_id String
  access_token     String?
  refresh_token    String?
  created_at       DateTime @default(now())
  users            users    @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_user_id])
}

model user_verifications {
  id                                       Int       @id @default(autoincrement())
  user_id                                  Int
  type                                     String
  status                                   String    @default("pending")
  document_url                             String?
  verification_code                        String?
  code_expires_at                          DateTime?
  admin_id                                 Int?
  admin_note                               String?
  verified_at                              DateTime?
  created_at                               DateTime  @default(now())
  users_user_verifications_admin_idTousers users?    @relation("user_verifications_admin_idTousers", fields: [admin_id], references: [id])
  users_user_verifications_user_idTousers  users     @relation("user_verifications_user_idTousers", fields: [user_id], references: [id])
}

model users {
  id                                                    Int                          @id @default(autoincrement())
  email                                                 String                       @unique
  password_hash                                         String?
  display_name                                          String
  bio                                                   String?
  phone                                                 String?
  profile_photo_url                                     String?
  preferred_language                                    String                       @default("ko")
  preferred_currency                                    String                       @default("KRW")
  role                                                  String                       @default("guest")
  is_host_approved                                      Boolean                      @default(false)
  email_verified                                        Boolean                      @default(false)
  phone_verified                                        Boolean                      @default(false)
  identity_verified                                     Boolean                      @default(false)
  identity_verified_at                                  DateTime?
  is_superhost                                          Boolean                      @default(false)
  superhost_since                                       DateTime?
  login_fail_count                                      Int                          @default(0)
  locked_until                                          DateTime?
  two_factor_enabled                                    Boolean                      @default(false)
  terms_agreed_at                                       DateTime
  privacy_agreed_at                                     DateTime
  marketing_consent                                     Boolean                      @default(false)
  status                                                String                       @default("active")
  suspension_reason                                     String?
  suspension_until                                      DateTime?
  withdrawal_requested_at                               DateTime?
  withdrawn_at                                          DateTime?
  created_at                                            DateTime                     @default(now())
  updated_at                                            DateTime                     @updatedAt
  accommodation_edit_history                            accommodation_edit_history[]
  accommodation_views                                   accommodation_views[]
  accommodations_accommodations_admin_idTousers         accommodations[]             @relation("accommodations_admin_idTousers")
  accommodations_accommodations_host_idTousers          accommodations[]             @relation("accommodations_host_idTousers")
  admin_activity_logs                                   admin_activity_logs[]
  auto_message_settings                                 auto_message_settings[]
  commission_settings                                   commission_settings[]
  conversation_rooms_conversation_rooms_host_idTousers  conversation_rooms[]         @relation("conversation_rooms_host_idTousers")
  conversation_rooms_conversation_rooms_guest_idTousers conversation_rooms[]         @relation("conversation_rooms_guest_idTousers")
  coupon_usages                                         coupon_usages[]
  host_penalties_host_penalties_admin_idTousers         host_penalties[]             @relation("host_penalties_admin_idTousers")
  host_penalties_host_penalties_host_idTousers          host_penalties[]             @relation("host_penalties_host_idTousers")
  host_profiles                                         host_profiles?
  login_history                                         login_history[]
  messages                                              messages[]
  notices                                               notices[]
  notifications                                         notifications[]
  payments                                              payments[]
  refresh_tokens                                        refresh_tokens[]
  report_actions                                        report_actions[]
  reports                                               reports[]
  reservation_admin_memos                               reservation_admin_memos[]
  reservation_changes                                   reservation_changes[]
  reservation_status_history                            reservation_status_history[]
  reservations_reservations_host_idTousers              reservations[]               @relation("reservations_host_idTousers")
  reservations_reservations_guest_idTousers             reservations[]               @relation("reservations_guest_idTousers")
  review_replies                                        review_replies[]
  reviews_reviews_reviewee_idTousers                    reviews[]                    @relation("reviews_reviewee_idTousers")
  reviews_reviews_reviewer_idTousers                    reviews[]                    @relation("reviews_reviewer_idTousers")
  saved_payment_methods                                 saved_payment_methods[]
  search_history                                        search_history[]
  settlements                                           settlements[]
  superhost_evaluations                                 superhost_evaluations[]
  system_settings                                       system_settings[]
  user_agreements                                       user_agreements[]
  user_devices                                          user_devices[]
  user_notification_settings                            user_notification_settings[]
  user_social_accounts                                  user_social_accounts[]
  user_verifications_user_verifications_admin_idTousers user_verifications[]         @relation("user_verifications_admin_idTousers")
  user_verifications_user_verifications_user_idTousers  user_verifications[]         @relation("user_verifications_user_idTousers")
  wishlist_folders                                      wishlist_folders[]
}

model wishlist_folders {
  id             Int              @id @default(autoincrement())
  user_id        Int
  name           String
  share_token    String?          @unique
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  users          users            @relation(fields: [user_id], references: [id])
  wishlist_items wishlist_items[]
}

model wishlist_items {
  id               Int              @id @default(autoincrement())
  folder_id        Int
  accommodation_id Int
  created_at       DateTime         @default(now())
  accommodations   accommodations   @relation(fields: [accommodation_id], references: [id])
  wishlist_folders wishlist_folders @relation(fields: [folder_id], references: [id])

  @@unique([folder_id, accommodation_id])
}
